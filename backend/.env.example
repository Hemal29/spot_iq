PORT=5000

# MongoDB Atlas connection string
# Get yours from https://cloud.mongodb.com -> Connect -> Drivers
# Replace <username>, <password>, and cluster address with your values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spotiq?retryWrites=true&w=majority

JWT_SECRET=spotiq_jwt_secret_key_2024
JWT_EXPIRE=7d

# Razorpay - optional for development
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email - optional for development
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NODE_ENV=development
